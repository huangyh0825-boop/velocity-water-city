{
  "name": "velocity-water-city",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:all": "node scripts/dev-with-lobby.mjs",
    "lobby": "tsx server/lobby.ts",
    "build:lobby": "tsc --noEmit -p server/tsconfig.json && node scripts/build-lobby.mjs",
    "dev:lobby:cloudflare": "wrangler dev --config cloudflare/wrangler.jsonc --env local --local",
    "check:lobby:cloudflare": "tsc -p cloudflare/tsconfig.json && tsc -p cloudflare/tsconfig.tests.json",
    "build:lobby:cloudflare": "npm run check:lobby:cloudflare && wrangler deploy --config cloudflare/wrangler.jsonc --env= --dry-run --outdir ../.qa/cloudflare-worker",
    "test:lobby:cloudflare": "vitest run --config cloudflare/vitest.config.ts",
    "deploy:lobby:cloudflare": "wrangler deploy --config cloudflare/wrangler.jsonc --env=",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "assets:build": "node scripts/build-models.mjs",
    "test": "tsx --test tests/*.test.ts",
    "assets:pack": "node scripts/pack-runtime-models.mjs"
  },
  "dependencies": {
    "three": "^0.180.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.6",
    "@cloudflare/workers-types": "5.20261019.1",
    "@types/node": "^22.0.0",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "meshoptimizer": "0.22.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  }
}
