{
  "name": "velocity-water-city",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:all": "node scripts/dev-with-lobby.mjs",
    "lobby": "tsx server/lobby.ts",
    "build:lobby": "tsc --noEmit && node scripts/build-lobby.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "assets:build": "node scripts/build-models.mjs",
    "test": "tsx --test tests/*.test.ts",
    "assets:pack": "node scripts/pack-runtime-models.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/three": "^0.180.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "tsx": "^4.20.0",
    "meshoptimizer": "0.22.0"
  }
}
